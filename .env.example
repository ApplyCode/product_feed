# BigCommerce API (Store-level API account)
BIGCOMMERCE_STORE_HASH=your_store_hash
BIGCOMMERCE_ACCESS_TOKEN=your_access_token

# Storefront base URL (no trailing slash), used to build product links
STORE_URL=https://www.yourstore.com

# Currency shown in Tolstoy optional columns
CURRENCY_CODE=USD
CURRENCY_SYMBOL=$

# Only include visible products (recommended)
ONLY_VISIBLE_PRODUCTS=true

# Where to write/publish the feed
# local  = output/tolstoy-products.csv only (local testing)
# github = public/tolstoy-products.csv (used by GitHub Actions → GitHub Pages)
# s3     = upload to AWS S3
PUBLISH_TARGET=local

# GitHub Pages URL (set in Tolstoy after enabling Pages)
# https://YOUR_USERNAME.github.io/YOUR_REPO/tolstoy-products.csv
GITHUB_PUBLIC_URL=

# S3 (when PUBLISH_TARGET=s3)
AWS_REGION=us-east-1
S3_BUCKET=your-public-bucket
S3_KEY=feeds/tolstoy-products.csv
# Optional: set if bucket is not public-read; use CloudFront or bucket policy instead
S3_PUBLIC_URL=https://your-public-bucket.s3.amazonaws.com/feeds/tolstoy-products.csv

# HTTP server (npm run serve) — stable URL on your host
SERVE_PORT=8080
SERVE_PATH=/feeds/tolstoy-products.csv
